# URL API Backend Laravel.
# Browser memanggil /api melalui proxy Vite; target backend dapat berada di komputer lain.
VITE_API_BASE_URL=/api
# Lokal: http://127.0.0.1:8000
# Lintas Wi-Fi dengan VPN privat: http://<IP-TAILSCALE-BACKEND>:8000
API_PROXY_TARGET=http://127.0.0.1:8000
# Alternatif: isi VITE_API_BASE_URL langsung dengan URL HTTPS API publik.
# Bila memakai URL API lintas origin, tambahkan origin frontend ke FRONTEND_URLS Laravel.
